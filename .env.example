# App
APP_NAME=CricCircle AI Service
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
PORT=8001

# Database (same PostgreSQL as NestJS backend)
DATABASE_URL=postgresql://criccircle:password@localhost:5432/criccircle_db

# Redis (same Redis as NestJS backend)
REDIS_URL=redis://localhost:6379

# AWS S3
USE_S3=false
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-south-1
S3_BUCKET_RAW_VIDEOS=criccircle-raw-videos
S3_BUCKET_HIGHLIGHTS=criccircle-highlights
S3_BUCKET_THUMBNAILS=criccircle-thumbnails

# Local storage fallback (used when USE_S3=false and/or Postgres isn't up)
USE_LOCAL_STORE=true
LOCAL_DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:8001

# Firebase (FCM)
FIREBASE_CREDENTIALS_PATH=./firebase_credentials.json

# NestJS Backend (to send webhooks back)
NESTJS_BACKEND_URL=http://localhost:3000
NESTJS_WEBHOOK_SECRET=your_webhook_secret

# ML Models
YOLO_MODEL_PATH=./models/yolo/cricket_yolo_v1.pt
CLASSIFIER_MODEL_PATH=./models/classifier/cricket_classifier_v1.pth
USE_GPU=false
CONFIDENCE_THRESHOLD=0.65

# Processing Settings
MAX_VIDEO_DURATION_SECONDS=1800
HIGHLIGHT_CLIP_DURATION=6
FRAMES_PER_SECOND=2
AUDIO_SPIKE_THRESHOLD=2.5
MAX_CONCURRENT_JOBS=3

# Branding
WATERMARK_PATH=./assets/criccircle_watermark.png
BRANDING_ENABLED=true
